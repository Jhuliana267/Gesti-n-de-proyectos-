# Copia este archivo como ".env" (en la carpeta backend) y completa los valores.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

# Clave para firmar las sesiones (JWT). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INVERSIM_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Mentor IA (opcional). Sin clave, el Mentor responde en "modo demo" con reglas simples. ---
# Elige UN proveedor:
AI_PROVIDER=gemini
GEMINI_API_KEY=
# AI_PROVIDER=openai
# OPENAI_API_KEY=

# Nombres de modelo (verifica en la documentación del proveedor cuál está vigente):
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-4o-mini

# --- Recuperación de contraseña (Gmail requiere una contraseña de aplicación) ---
# Crea una contraseña de aplicación en la configuración de seguridad de tu cuenta Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:5173

# Operaciones necesarias para desbloquear cada evaluación (por defecto 5)
# OPS_POR_CICLO=5
# Cada cuántos segundos se guarda una foto del patrimonio (86400 = diario)
# SNAPSHOT_INTERVALO_SEGUNDOS=60
